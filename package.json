{
  "name": "markdown-mirror",
  "displayName": "Markdown Mirror - Live Markdown Preview",
  "description": "Live markdown preview for your workspace — diagrams, math, search, export, quality tools, and instant hot reload in VS Code or browser.",
  "version": "0.7.1",
  "publisher": "ForkedCode",
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#1f2937",
    "theme": "dark"
  },
  "license": "MIT",
  "keywords": [
    "markdown",
    "markdown preview",
    "live preview",
    "documentation",
    "mermaid",
    "plantuml",
    "katex",
    "openapi",
    "yaml",
    "export",
    "docs",
    "wiki",
    "technical writing",
    "vscode markdown"
  ],
  "engines": {
    "vscode": "^1.98.0"
  },
  "categories": [
    "Visualization",
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/*.md",
    "workspaceContains:**/*.{yaml,yml,json}",
    "onCommand:markdownMirror.start",
    "onCommand:markdownMirror.openNativePreview",
    "onCommand:markdownMirror.openActiveInPreview",
    "onCommand:markdownMirror.runDocumentAudit",
    "onCommand:markdownMirror.runWorkspaceAudit",
    "onCommand:markdownMirror.findHeading",
    "onCommand:markdownMirror.validateLinks",
    "onCommand:markdownMirror.checkExternalLinks",
    "onCommand:markdownMirror.stop",
    "onCommand:markdownMirror.compareWithGit"
  ],
  "contributes": {
    "commands": [
      {
        "command": "markdownMirror.start",
        "title": "Markdown Mirror: Start"
      },
      {
        "command": "markdownMirror.openNativePreview",
        "title": "Markdown Mirror: Open Preview"
      },
      {
        "command": "markdownMirror.stop",
        "title": "Markdown Mirror: Stop"
      },
      {
        "command": "markdownMirror.openInPreview",
        "title": "Markdown Mirror: Open in Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownMirror.exportToWord",
        "title": "Markdown Mirror: Export to Word",
        "icon": "$(export)"
      },
      {
        "command": "markdownMirror.openActiveInPreview",
        "title": "Markdown Mirror: Preview Active File",
        "icon": "$(open-preview)"
      },
      {
        "command": "markdownMirror.refreshFileTree",
        "title": "Markdown Mirror: Refresh Files",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownMirror.refreshToc",
        "title": "Markdown Mirror: Refresh TOC",
        "icon": "$(refresh)"
      },
      {
        "command": "markdownMirror.revealHeadingInPreview",
        "title": "Markdown Mirror: Go to Heading in Preview",
        "icon": "$(symbol-key)"
      },
      {
        "command": "markdownMirror.revealHeadingInEditor",
        "title": "Markdown Mirror: Go to Heading in Editor",
        "icon": "$(go-to-file)"
      },
      {
        "command": "markdownMirror.exportHtml",
        "title": "Markdown Mirror: Export HTML",
        "icon": "$(export)"
      },
      {
        "command": "markdownMirror.printPreview",
        "title": "Markdown Mirror: Print / PDF",
        "icon": "$(print)"
      },
      {
        "command": "markdownMirror.openCompareMode",
        "title": "Markdown Mirror: Compare Mode",
        "icon": "$(split-horizontal)"
      },
      {
        "command": "markdownMirror.openSlidesMode",
        "title": "Markdown Mirror: Slides Mode",
        "icon": "$(device-camera-video)"
      },
      {
        "command": "markdownMirror.runDocumentAudit",
        "title": "Markdown Mirror: Review Document",
        "icon": "$(report)"
      },
      {
        "command": "markdownMirror.openReviewMode",
        "title": "Markdown Mirror: Review Mode",
        "icon": "$(preview)"
      },
      {
        "command": "markdownMirror.runWorkspaceAudit",
        "title": "Markdown Mirror: Review Workspace",
        "icon": "$(check-all)"
      },
      {
        "command": "markdownMirror.validateLinks",
        "title": "Markdown Mirror: Validate Links",
        "icon": "$(link)"
      },
      {
        "command": "markdownMirror.checkExternalLinks",
        "title": "Markdown Mirror: Check External Links",
        "icon": "$(globe)"
      },
      {
        "command": "markdownMirror.findHeading",
        "title": "Markdown Mirror: Find Heading",
        "icon": "$(search)"
      },
      {
        "command": "markdownMirror.showBacklinks",
        "title": "Markdown Mirror: Show Backlinks",
        "icon": "$(references)"
      },
      {
        "command": "markdownMirror.toggleFocusMode",
        "title": "Markdown Mirror: Toggle Focus Mode",
        "icon": "$(eye)"
      },
      {
        "command": "markdownMirror.exportHtmlWithProfile",
        "title": "Markdown Mirror: Export HTML with Profile",
        "icon": "$(export)"
      },
      {
        "command": "markdownMirror.composeWorkspaceBundle",
        "title": "Markdown Mirror: Compose Bundle",
        "icon": "$(files)"
      },
      {
        "command": "markdownMirror.toggleSetting",
        "title": "Markdown Mirror: Toggle Setting",
        "icon": "$(gear)"
      },
      {
        "command": "markdownMirror.copyServerUrl",
        "title": "Markdown Mirror: Copy Server URL",
        "icon": "$(copy)"
      },
      {
        "command": "markdownMirror.shareViaTunnel",
        "title": "Markdown Mirror: Share via Dev Tunnel",
        "icon": "$(globe)"
      },
      {
        "command": "markdownMirror.compareWithGit",
        "title": "Markdown Mirror: Compare with Git (Rendered Diff)",
        "icon": "$(git-compare)"
      },
      {
        "command": "markdownMirror.formatBold",
        "title": "Markdown Mirror: Bold",
        "icon": "$(bold)"
      },
      {
        "command": "markdownMirror.formatItalic",
        "title": "Markdown Mirror: Italic",
        "icon": "$(italic)"
      },
      {
        "command": "markdownMirror.formatHeading",
        "title": "Markdown Mirror: Heading",
        "icon": "$(text-size)"
      },
      {
        "command": "markdownMirror.formatLink",
        "title": "Markdown Mirror: Insert Link",
        "icon": "$(link)"
      },
      {
        "command": "markdownMirror.formatCode",
        "title": "Markdown Mirror: Code",
        "icon": "$(code)"
      },
      {
        "command": "markdownMirror.formatBulletList",
        "title": "Markdown Mirror: Bullet List",
        "icon": "$(list-unordered)"
      },
      {
        "command": "markdownMirror.formatNumberedList",
        "title": "Markdown Mirror: Numbered List",
        "icon": "$(list-ordered)"
      },
      {
        "command": "markdownMirror.formatBlockquote",
        "title": "Markdown Mirror: Blockquote",
        "icon": "$(quote)"
      },
      {
        "command": "markdownMirror.formatTable",
        "title": "Markdown Mirror: Insert Table",
        "icon": "$(symbol-namespace)"
      },
      {
        "command": "markdownMirror.formatHorizontalRule",
        "title": "Markdown Mirror: Horizontal Rule",
        "icon": "$(horizontal-rule)"
      },
      {
        "command": "markdownMirror.excludePath",
        "title": "Markdown Mirror: Exclude from Preview"
      },
      {
        "command": "markdownMirror.includePath",
        "title": "Markdown Mirror: Include in Preview"
      }
    ],
    "configuration": {
      "title": "Markdown Mirror",
      "properties": {
        "markdownMirror.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Automatically start Markdown Mirror when VS Code starts and a markdown workspace is open."
        },
        "markdownMirror.autoOpenMode": {
          "type": "string",
          "enum": [
            "always",
            "firstRun",
            "never"
          ],
          "default": "firstRun",
          "markdownEnumDescriptions": [
            "Open browser every time Markdown Mirror auto-starts.",
            "Open browser only the first time Markdown Mirror auto-starts on this machine.",
            "Never open browser automatically."
          ],
          "description": "Controls browser auto-open behavior during auto-start. Manual Start always opens the browser."
        },
        "markdownMirror.hostMode": {
          "type": "string",
          "enum": [
            "browser",
            "vscode",
            "both"
          ],
          "default": "vscode",
          "markdownEnumDescriptions": [
            "Open Markdown Mirror only in an external browser.",
            "Open Markdown Mirror only inside a native VS Code webview panel.",
            "Open Markdown Mirror in both VS Code native panel and external browser."
          ],
          "description": "Controls where the preview UI is hosted when Markdown Mirror starts."
        },
        "markdownMirror.nativeFollowVsCodeTheme": {
          "type": "boolean",
          "default": true,
          "description": "When host mode includes VS Code, mirror the active VS Code light/dark theme in native preview."
        },
        "markdownMirror.nativeLockThemeToggle": {
          "type": "boolean",
          "default": true,
          "description": "When native theme sync is enabled, lock the in-preview light/dark toggle so VS Code theme remains the source of truth."
        },
        "markdownMirror.nativeUiProfile": {
          "type": "string",
          "enum": [
            "focused",
            "classic"
          ],
          "default": "focused",
          "markdownEnumDescriptions": [
            "Minimal native layout: reduced chrome, single-pane emphasis, and lower visual clutter.",
            "Full browser-style layout inside native host."
          ],
          "description": "Controls native preview layout style when running inside VS Code."
        },
        "markdownMirror.enableQualityDiagnostics": {
          "type": "boolean",
          "default": false,
          "description": "Show live quality diagnostics for markdown files in the Problems panel."
        },
        "markdownMirror.enableExternalLinkCheck": {
          "type": "boolean",
          "default": true,
          "description": "Enable checking external URLs for broken links."
        },
        "markdownMirror.maxLineLength": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Line-length limit used by Mirror quality checks. Set 0 to disable this check."
        },
        "markdownMirror.enablePlantUml": {
          "type": "boolean",
          "default": false,
          "description": "Enable PlantUML diagram rendering. Requires a PlantUML server (default: public server at plantuml.com)."
        },
        "markdownMirror.plantUmlServer": {
          "type": "string",
          "default": "https://www.plantuml.com/plantuml",
          "description": "PlantUML server URL for diagram rendering."
        },
        "markdownMirror.enableMermaid": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mermaid diagram rendering for fenced mermaid code blocks."
        },
        "markdownMirror.htmlMode": {
          "type": "string",
          "enum": [
            "safe",
            "trusted"
          ],
          "default": "safe",
          "markdownEnumDescriptions": [
            "Sanitize rendered HTML to reduce XSS risk.",
            "Trust raw HTML in markdown without sanitization. Use only for trusted local content."
          ],
          "description": "Controls how raw HTML inside markdown is handled."
        },
        "markdownMirror.rootPath": {
          "type": "string",
          "scope": "resource",
          "default": "",
          "description": "Legacy single-folder scope. Relative path only (for example docs or Compiler). Absolute paths and traversal segments are ignored.",
          "deprecationMessage": "Use markdownMirror.rootPaths for multiple folder scopes."
        },
        "markdownMirror.rootPaths": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Optional list of relative folder paths (for example [\"docs\", \"notes/specs\"]). Absolute paths and traversal segments are ignored. In multi-root workspaces, each path is resolved inside each workspace folder."
        },
        "markdownMirror.excludePaths": {
          "type": "array",
          "scope": "resource",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "List of relative folder or file paths to exclude from the file tree and browser sidebar (for example [\"drafts\", \"archive/old-specs\"]). Glob patterns like \"**/private\" are also supported."
        },
        "markdownMirror.enableMath": {
          "type": "boolean",
          "default": true,
          "description": "Enable KaTeX math rendering for inline ($...$) and block ($$...$$) expressions."
        },
        "markdownMirror.mermaidTheme": {
          "type": "string",
          "enum": [
            "default",
            "dark",
            "forest",
            "neutral"
          ],
          "default": "default",
          "markdownEnumDescriptions": [
            "Use default Mermaid theme in light mode and dark Mermaid theme in dark mode.",
            "Always use Mermaid dark theme.",
            "Always use Mermaid forest theme.",
            "Always use Mermaid neutral theme."
          ],
          "description": "Controls Mermaid diagram theme in browser preview."
        },
        "markdownMirror.showFrontmatter": {
          "type": "string",
          "enum": [
            "card",
            "none"
          ],
          "default": "card",
          "markdownEnumDescriptions": [
            "Render YAML frontmatter as a collapsible metadata card above content.",
            "Do not render frontmatter in preview."
          ],
          "description": "Controls how YAML frontmatter is displayed in preview."
        },
        "markdownMirror.customCssPath": {
          "type": "string",
          "default": "",
          "description": "Optional relative CSS file path inside workspace to inject into browser preview."
        },
        "markdownMirror.defaultCompareMode": {
          "type": "boolean",
          "default": false,
          "description": "Open Markdown Mirror in compare mode by default for new browser sessions."
        },
        "markdownMirror.defaultTocVisible": {
          "type": "boolean",
          "default": true,
          "description": "Show the TOC panel by default for new browser sessions."
        },
        "markdownMirror.defaultTheme": {
          "type": "string",
          "enum": [
            "light",
            "dark"
          ],
          "default": "light",
          "markdownEnumDescriptions": [
            "Start preview in light mode.",
            "Start preview in dark mode."
          ],
          "description": "Default preview theme used when no saved browser preference exists."
        },
        "markdownMirror.defaultWidthMode": {
          "type": "string",
          "enum": [
            "full",
            "reading"
          ],
          "default": "full",
          "markdownEnumDescriptions": [
            "Use full-width layout by default.",
            "Use reading-width layout by default."
          ],
          "description": "Default content width mode used when no saved browser preference exists."
        },
        "markdownMirror.enablePrint": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable Print / PDF action in preview."
        },
        "markdownMirror.enableHtmlExport": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable Export HTML action in preview."
        },
        "markdownMirror.enableWordExport": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable Export Word action in preview."
        },
        "markdownMirror.enableSlides": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable Slides mode action in preview."
        },
        "markdownMirror.enableCompare": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable Compare mode action in preview."
        },
        "markdownMirror.enableToc": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable TOC panel action in preview."
        },
        "markdownMirror.enableThemeToggle": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable light/dark theme toggle in preview."
        },
        "markdownMirror.enableWidthToggle": {
          "type": "boolean",
          "default": true,
          "description": "Show and enable reading/full width toggle in preview."
        },
        "markdownMirror.startExplorerCollapsed": {
          "type": "boolean",
          "default": false,
          "description": "Start browser preview with the file explorer sidebar collapsed."
        },
        "markdownMirror.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Fixed port number for the preview server. Set 0 for auto-assign. Use a fixed port for dev tunnel sharing."
        },
        "markdownMirror.defaultFilePath": {
          "type": "string",
          "default": "",
          "description": "Relative path (e.g. README.md) of the file to open automatically on browser launch. Leave empty to use normal selection."
        },
        "markdownMirror.enableDataFiles": {
          "type": "boolean",
          "default": true,
          "description": "Include YAML and JSON files in the workspace explorer and enable rich preview rendering."
        },
        "markdownMirror.previewFileTypes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["md", "yaml", "yml", "json", "jsonc", "xml"],
          "description": "File extensions that open in Markdown Mirror preview by default when clicked. Remove an extension to make those files open in the normal text editor instead. To switch for a single file: right-click → Open With... → Text Editor."
        },
        "markdownMirror.dataFileExtensions": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            ".yaml",
            ".yml",
            ".json",
            ".xml"
          ],
          "description": "File extensions to treat as data files for rich preview. Only applies when enableDataFiles is true."
        },
        "markdownMirror.enableSearch": {
          "type": "boolean",
          "default": true,
          "description": "Enable full-text search across all workspace files in the browser preview."
        },
        "markdownMirror.enableTransclusion": {
          "type": "boolean",
          "default": true,
          "description": "Enable content transclusion via <!-- include: path --> directives in markdown files."
        },
        "markdownMirror.autoFixLinksOnRename": {
          "type": "boolean",
          "default": true,
          "description": "Automatically update markdown links across the workspace when a markdown file is renamed or moved."
        }
      }
    },
    "customEditors": [
      {
        "viewType": "markdownMirror.preview",
        "displayName": "Markdown Mirror Preview",
        "selector": [
          { "filenamePattern": "*.md" }
        ],
        "priority": "default"
      },
      {
        "viewType": "markdownMirror.preview",
        "displayName": "Markdown Mirror Preview",
        "selector": [
          { "filenamePattern": "*.yaml" },
          { "filenamePattern": "*.yml" },
          { "filenamePattern": "*.json" },
          { "filenamePattern": "*.jsonc" },
          { "filenamePattern": "*.xml" }
        ],
        "priority": "option"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "markdownMirrorExplorer",
          "title": "Markdown Mirror",
          "icon": "$(book)"
        }
      ]
    },
    "views": {
      "markdownMirrorExplorer": [
        {
          "id": "markdownMirror.fileTree",
          "name": "Markdown Files"
        },
        {
          "id": "markdownMirror.tocTree",
          "name": "Table of Contents"
        },
        {
          "id": "markdownMirror.settingsTree",
          "name": "Quick Settings"
        }
      ]
    },
    "submenus": [
      {
        "id": "markdownMirror.formatSubmenu",
        "label": "Markdown Mirror: Format"
      }
    ],
    "menus": {
      "markdownMirror.formatSubmenu": [
        { "command": "markdownMirror.formatBold", "group": "1_text@1" },
        { "command": "markdownMirror.formatItalic", "group": "1_text@2" },
        { "command": "markdownMirror.formatHeading", "group": "1_text@3" },
        { "command": "markdownMirror.formatLink", "group": "1_text@4" },
        { "command": "markdownMirror.formatCode", "group": "1_text@5" },
        { "command": "markdownMirror.formatBulletList", "group": "2_block@1" },
        { "command": "markdownMirror.formatNumberedList", "group": "2_block@2" },
        { "command": "markdownMirror.formatBlockquote", "group": "2_block@3" },
        { "command": "markdownMirror.formatTable", "group": "2_block@4" },
        { "command": "markdownMirror.formatHorizontalRule", "group": "2_block@5" }
      ],
      "editor/title": [
        {
          "command": "markdownMirror.openActiveInPreview",
          "group": "navigation",
          "when": "resourceLangId == markdown"
        }
      ],
      "view/title": [
        {
          "command": "markdownMirror.openActiveInPreview",
          "when": "view == markdownMirror.fileTree",
          "group": "navigation"
        },
        {
          "command": "markdownMirror.refreshFileTree",
          "when": "view == markdownMirror.fileTree",
          "group": "navigation@1"
        },
        {
          "command": "markdownMirror.refreshToc",
          "when": "view == markdownMirror.tocTree",
          "group": "navigation"
        },
        {
          "command": "markdownMirror.runWorkspaceAudit",
          "when": "view == markdownMirror.fileTree",
          "group": "navigation@2"
        },
        {
          "command": "markdownMirror.composeWorkspaceBundle",
          "when": "view == markdownMirror.fileTree",
          "group": "navigation@3"
        }
      ],
      "view/item/context": [
        {
          "command": "markdownMirror.openInPreview",
          "when": "view == markdownMirror.fileTree && viewItem == markdownMirror.file",
          "group": "inline"
        },
        {
          "command": "markdownMirror.showBacklinks",
          "when": "view == markdownMirror.fileTree && viewItem == markdownMirror.file",
          "group": "1_actions"
        },
        {
          "command": "markdownMirror.exportHtml",
          "when": "view == markdownMirror.fileTree && viewItem == markdownMirror.file",
          "group": "2_export"
        },
        {
          "command": "markdownMirror.exportToWord",
          "when": "view == markdownMirror.fileTree && viewItem == markdownMirror.file",
          "group": "2_export"
        },
        {
          "command": "markdownMirror.revealHeadingInPreview",
          "when": "view == markdownMirror.tocTree && viewItem == markdownMirror.tocHeading",
          "group": "inline"
        },
        {
          "command": "markdownMirror.revealHeadingInEditor",
          "when": "view == markdownMirror.tocTree && viewItem == markdownMirror.tocHeading",
          "group": "navigation"
        }
      ],
      "explorer/context": [
        {
          "command": "markdownMirror.openInPreview",
          "when": "resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "markdownMirror.start",
          "when": "resourceExtname == .md",
          "group": "navigation@100"
        },
        {
          "command": "markdownMirror.excludePath",
          "group": "7_modification@1"
        },
        {
          "command": "markdownMirror.includePath",
          "group": "7_modification@2"
        }
      ],
      "editor/context": [
        {
          "submenu": "markdownMirror.formatSubmenu",
          "when": "resourceLangId == markdown",
          "group": "1_modification@0"
        },
        {
          "command": "markdownMirror.openActiveInPreview",
          "when": "resourceExtname == .md",
          "group": "navigation@99"
        },
        {
          "command": "markdownMirror.start",
          "when": "resourceExtname == .md",
          "group": "navigation@100"
        },
        {
          "command": "markdownMirror.compareWithGit",
          "when": "resourceExtname == .md",
          "group": "navigation@101"
        }
      ]
    },
    "keybindings": [
      {
        "command": "markdownMirror.formatBold",
        "key": "ctrl+b",
        "when": "resourceLangId == markdown && editorTextFocus"
      },
      {
        "command": "markdownMirror.formatItalic",
        "key": "ctrl+i",
        "when": "resourceLangId == markdown && editorTextFocus"
      },
      {
        "command": "markdownMirror.formatHeading",
        "key": "ctrl+shift+h",
        "when": "resourceLangId == markdown && editorTextFocus"
      },
      {
        "command": "markdownMirror.formatLink",
        "key": "ctrl+k",
        "when": "resourceLangId == markdown && editorTextFocus"
      },
      {
        "command": "markdownMirror.formatCode",
        "key": "ctrl+shift+`",
        "when": "resourceLangId == markdown && editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "clean": "node -e \"require('fs').rmSync('out',{recursive:true,force:true})\"",
    "clean:vsix": "node -e \"const fs=require('fs');for(const f of fs.readdirSync('.')){if(f.toLowerCase().endsWith('.vsix')) fs.rmSync(f,{force:true});}\"",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build": "npm run clean && node ./scripts/esbuild.mjs",
    "package": "npm run clean:vsix && npm run build && npx @vscode/vsce package",
    "publish": "npm run clean:vsix && npm run build && npx @vscode/vsce publish"
  },
  "dependencies": {
    "express": "^4.21.2",
    "fast-xml-parser": "^5.7.3",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.1.0",
    "markdown-it": "^14.1.0",
    "markdown-it-task-lists": "^2.1.1",
    "sanitize-html": "^2.14.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/js-yaml": "^4.0.9",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.17.24",
    "@types/sanitize-html": "^2.13.0",
    "@types/vscode": "^1.98.0",
